# Supabase (server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PROJECT_ID=your_project_ref

# Supabase (client — Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_ref

# Optional: direct Postgres for migrations (Dashboard > Database > password)
# SUPABASE_DB_PASSWORD=

# App public URL (OAuth redirects + webhooks)
APP_URL=http://localhost:5173

# Nuvemshop Partner App
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=

# Shopify Partner App
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Mercado Livre Partner App
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Melhor Envio
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_FROM_POSTAL=01310100

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=

# Mercado Pago (assinaturas B2B)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_KEY=

# WhatsApp Cloud API (webhook verification)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Google Ads API (OAuth + sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional MCC manager account ID (digits only, no dashes)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Resend (email pós-entrega)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Focus NFe (homologacao | producao)
FOCUS_NFE_TOKEN=
FOCUS_NFE_ENV=homologacao

# Cloudflare Workers deploy
CLOUDFLARE_API_TOKEN=

